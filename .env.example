# =============================================================================
# DEVBRAID-BACKEND Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# COMMON CONFIGURATION (used across all profiles)
# -----------------------------------------------------------------------------
# Active Spring profile: dev, stage, or prod
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# COMMON DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Profile-specific files own DB credentials.
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30000

# -----------------------------------------------------------------------------
# JPA / HIBERNATE CONFIGURATION
# -----------------------------------------------------------------------------
# Hibernate DDL auto: none, validate, update, create, create-drop
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# -----------------------------------------------------------------------------
# FLYWAY MIGRATION
# -----------------------------------------------------------------------------
FLYWAY_ENABLED=true

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin

# JWT Configuration (REQUIRED - no default for production!)
JWT_SECRET=your-256-bit-secret-key-here
JWT_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_BIND=TRACE

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
API_VERSION=v1

# =============================================================================
# DEVELOPMENT PROFILE (SPRING_PROFILES_ACTIVE=dev)
# =============================================================================

# Development Database
DEV_DB_URL=jdbc:postgresql://localhost:5433/devbraid
DEV_DB_USERNAME=devbraid_user
DEV_DB_PASSWORD=devbraid_password
DEV_DB_POOL_MAX_SIZE=5
DEV_DB_POOL_MIN_IDLE=2

# Development JPA
DEV_JPA_SHOW_SQL=true
DEV_JPA_DDL_AUTO=update
DEV_JPA_FORMAT_SQL=true

# Development Flyway
DEV_FLYWAY_ENABLED=true

# Development Server
DEV_SERVER_PORT=8080

# Development Logging
DEV_LOG_LEVEL_ROOT=INFO
DEV_LOG_LEVEL_APP=DEBUG
DEV_LOG_LEVEL_HIBERNATE_SQL=DEBUG
DEV_LOG_LEVEL_HIBERNATE_BIND=TRACE
DEV_LOG_LEVEL_WEB=DEBUG
DEV_LOG_LEVEL_SECURITY=DEBUG

# Development CORS
DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
DEV_CORS_ALLOW_CREDENTIALS=true

# Development JWT
DEV_JWT_SECRET=dev-jwt-secret-key-for-development-only-12345678901234567890
DEV_JWT_EXPIRATION=86400000

# Development Features
DEV_FEATURES_SWAGGER_UI=true
DEV_FEATURES_API_DOCS=true
DEV_FEATURES_ACTUATOR=true

# =============================================================================
# STAGING PROFILE (SPRING_PROFILES_ACTIVE=stage)
# =============================================================================

# Staging Database (REQUIRED)
STAGE_DB_URL=jdbc:postgresql://staging-db:5432/devbraid
STAGE_DB_USERNAME=staging_user
STAGE_DB_PASSWORD=staging_password_change_me

# Staging Server
STAGE_SERVER_PORT=8080

# Staging CORS
STAGE_CORS_ORIGINS=https://staging.devbraid.com

# Staging JWT (REQUIRED)
STAGE_JWT_SECRET=stage-jwt-secret-change-in-real-staging-environment-1234567890
STAGE_JWT_EXPIRATION=86400000

# =============================================================================
# PRODUCTION PROFILE (SPRING_PROFILES_ACTIVE=prod)
# =============================================================================

# Production Database (ALL REQUIRED)
PROD_DB_URL=jdbc:postgresql://prod-db:5432/devbraid
PROD_DB_USERNAME=prod_user
PROD_DB_PASSWORD=prod_password_change_me

# Production Connection Pool
PROD_DB_POOL_MAX_SIZE=25
PROD_DB_POOL_MIN_IDLE=10
PROD_DB_POOL_TIMEOUT=30000
PROD_DB_POOL_IDLE_TIMEOUT=600000
PROD_DB_POOL_MAX_LIFETIME=1800000

# Production Server
PROD_SERVER_PORT=8080

# Production Tomcat
PROD_TOMCAT_MAX_THREADS=200
PROD_TOMCAT_MIN_SPARE_THREADS=25
PROD_TOMCAT_ACCEPT_COUNT=100

# Production CORS
PROD_CORS_ORIGINS=https://app.devbraid.com

# Production JWT (REQUIRED)
PROD_JWT_SECRET=prod-jwt-secret-change-in-real-production-environment-1234567890
PROD_JWT_EXPIRATION=86400000

# Production Security
PROD_FORCE_HTTPS=true
PROD_HSTS_ENABLED=true
PROD_CSP=default-src 'self'

# Production Actuator
MANAGEMENT_SERVER_PORT=9090

# =============================================================================
# QUICK START
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and set required values (marked with REQUIRED)
# 3. For development: SPRING_PROFILES_ACTIVE=dev
# 4. For staging: SPRING_PROFILES_ACTIVE=stage
# 5. For production: SPRING_PROFILES_ACTIVE=prod
#
# Run with profile:
#   ./mvnw spring-boot:run -Dspring-boot.run.arguments="--spring.profiles.active=dev"
#
# Or set environment variable:
#   export SPRING_PROFILES_ACTIVE=dev
#   ./mvnw spring-boot:run
# =============================================================================
