# =============================================================================
# DEVBRAID-BACKEND Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# COMMON CONFIGURATION (used across all profiles)
# -----------------------------------------------------------------------------
# Active Spring profile: dev, stage, or prod
SPRING_PROFILES_ACTIVE=dev

# Server port (Render sets PORT automatically)
PORT=8080

# -----------------------------------------------------------------------------
# CLERK AUTH (required for all profiles)
# -----------------------------------------------------------------------------
# Identity + email OTP lives in Clerk. The backend verifies session tokens
# against Clerk's published JWKS. Create a free Clerk app, then:
#   1. Copy your instance URL (e.g. https://your-app.clerk.accounts) into CLERK_ISSUER
#   2. Set CLERK_JWKS_URL to https://your-app.clerk.accounts/.well-known/jwks.json
#   3. In Clerk dashboard: Sessions → Customize session token → add claims
#      `email`, `fullName` (or `first_name`/`last_name`) so the backend can
#      mirror your profile.
CLERK_JWKS_URL=https://your-app.clerk.accounts/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts

# -----------------------------------------------------------------------------
# PGADMIN CONFIGURATION (Docker dev only)
# -----------------------------------------------------------------------------
# Web UI at http://localhost:5050
PGADMIN_EMAIL=admin@devbraid.com
PGADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# DATABASE / JPA / FLYWAY (common defaults)
# -----------------------------------------------------------------------------
DB_POOL_TIMEOUT=30000
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
FLYWAY_ENABLED=true

# -----------------------------------------------------------------------------
# SERVER / LOGGING (common defaults)
# -----------------------------------------------------------------------------
SERVER_CONTEXT_PATH=/
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_BIND=TRACE

# -----------------------------------------------------------------------------
# CORS / API (common defaults)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
API_VERSION=v1

# -----------------------------------------------------------------------------
# AI PROVIDERS (optional — graceful degradation when unset)
# -----------------------------------------------------------------------------
AI_PROVIDER=openai
AI_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# =============================================================================
# DEVELOPMENT PROFILE (SPRING_PROFILES_ACTIVE=dev)
# =============================================================================

# Local PostgreSQL (Docker)
DEV_DB_URL=jdbc:postgresql://localhost:5433/devbraid
DEV_DB_USERNAME=devbraid_user
DEV_DB_PASSWORD=devbraid_password
DEV_DB_POOL_MAX_SIZE=5
DEV_DB_POOL_MIN_IDLE=2

DEV_JPA_SHOW_SQL=true
DEV_JPA_DDL_AUTO=update
DEV_JPA_FORMAT_SQL=true
DEV_FLYWAY_ENABLED=true
DEV_SERVER_PORT=8080

DEV_LOG_LEVEL_ROOT=INFO
DEV_LOG_LEVEL_APP=DEBUG
DEV_LOG_LEVEL_HIBERNATE_SQL=DEBUG
DEV_LOG_LEVEL_HIBERNATE_BIND=TRACE
DEV_LOG_LEVEL_WEB=DEBUG
DEV_LOG_LEVEL_SECURITY=DEBUG

DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
DEV_CORS_ALLOW_CREDENTIALS=true

# PAT encryption (AES-256-GCM) — generate with: openssl rand -hex 32
# The dev default below is INSECURE — set a real value.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# STAGING PROFILE (SPRING_PROFILES_ACTIVE=stage)
# =============================================================================

# Neon Postgres (free serverless PG). Use the pooled connection string:
# postgresql://<user>:<password>@<host>-pooler.aws.neon.tech/devbraid?sslmode=require
STAGE_DB_URL=jdbc:postgresql://replace-with-neon-pooled-host/devbraid?sslmode=require
STAGE_DB_USERNAME=devbraid_user
STAGE_DB_PASSWORD=change_me
STAGE_DB_POOL_MAX_SIZE=10
STAGE_DB_POOL_MIN_IDLE=2

STAGE_CORS_ORIGINS=https://staging.devbraid.com

# REQUIRED — generate with: openssl rand -hex 32
STAGE_ENCRYPTION_KEY=replace-me

# =============================================================================
# PRODUCTION PROFILE (SPRING_PROFILES_ACTIVE=prod)
# =============================================================================

# Neon Postgres (free serverless PG) — ALL REQUIRED, no defaults (fail fast)
PROD_DB_URL=jdbc:postgresql://replace-with-neon-pooled-host/devbraid?sslmode=require
PROD_DB_USERNAME=devbraid_user
PROD_DB_PASSWORD=change_me
PROD_DB_POOL_MAX_SIZE=10
PROD_DB_POOL_MIN_IDLE=2
PROD_DB_POOL_TIMEOUT=30000
PROD_DB_POOL_IDLE_TIMEOUT=600000
PROD_DB_POOL_MAX_LIFETIME=1800000

PROD_CORS_ORIGINS=https://app.devbraid.com

# REQUIRED — generate with: openssl rand -hex 32
PROD_ENCRYPTION_KEY=replace-me

# Tomcat tuning (optional)
PROD_TOMCAT_MAX_THREADS=200
PROD_TOMCAT_MIN_SPARE_THREADS=25
PROD_TOMCAT_ACCEPT_COUNT=100

# =============================================================================
# QUICK START
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Set CLERK_JWKS_URL / CLERK_ISSUER (see CLERK section above)
# 3. Set DEV_* for local, or PROD_* on Render
# 4. Start dev: docker compose up -d --build
# =============================================================================
